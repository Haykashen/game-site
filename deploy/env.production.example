# Copy this file to the repository root as `.env` and replace every value.
# Docker Compose reads it automatically for ${...} substitutions.

# Public hostname. If you do not have a domain, use the VPS public IP:
# 203.0.113.10.sslip.io (or 203-0-113-10.sslip.io).
APP_DOMAIN=203.0.113.10.sslip.io

# PostgreSQL inside Docker Compose.
POSTGRES_USER=discvault
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=discvault

# Keep the password in sync with POSTGRES_PASSWORD above.
# Use a password without characters that need URL encoding, or URL-encode it.
DATABASE_URL=postgresql://discvault:change-me-db-password@db:5432/discvault?schema=public

# Same public origin as APP_DOMAIN.
CORS_ORIGINS=https://203.0.113.10.sslip.io
PUBLIC_API_URL=https://203.0.113.10.sslip.io

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760

# Leave S3_* empty to store uploaded photos in the `uploads` Docker volume.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Demo account created by `npx prisma db seed`.
SEED_DEMO_EMAIL=admin@example.com
SEED_DEMO_PASSWORD=change-me-demo-password
SEED_DEMO_ROLE=admin

# Required by the seed script when NODE_ENV=production.
# Set to false or remove after the initial seed if you do not want demo data.
ALLOW_DEMO_SEED=true

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketKind {
  listing
  auction
}

enum ListingType {
  sale
  purchase
  exchange
}

enum MarketStatus {
  active
  sold
  closed
}

enum DeliveryService {
  russian_post @map("russian-post")
  cdek
  yandex
  other

  @@map("delivery_service")
}

enum DealStatus {
  pending
  completed
  cancelled
}

enum UserRole {
  user
  moderator
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum ModerationStatus {
  visible
  hidden
  removed
}

enum ReportTargetType {
  market_entry
  user
}

enum ReportReason {
  fraud
  prohibited
  offensive
  spam
  wrong_category
  other
}

enum ReportStatus {
  pending
  in_review
  resolved
  dismissed
}

enum ReportAction {
  none
  hide_entry
  suspend_user
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  passwordHash     String?    @map("password_hash")
  displayName      String     @map("display_name")
  phone            String?
  city             String?
  avatarUrl        String?    @map("avatar_url") @db.Text
  isDemo           Boolean    @default(false) @map("is_demo")
  role             UserRole   @default(user)
  status           UserStatus @default(active)
  suspendedAt      DateTime?  @map("suspended_at")
  suspensionReason String?    @map("suspension_reason") @db.Text

  ratingSum   Int @default(0) @map("rating_sum")
  ratingCount Int @default(0) @map("rating_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  copies           Copy[]
  authoredEntries  MarketEntry[] @relation("MarketAuthor")
  wonEntries       MarketEntry[] @relation("MarketWinner")
  bids             Bid[]
  buyerDeals       Deal[]        @relation("DealBuyer")
  sellerDeals      Deal[]        @relation("DealSeller")
  writtenReviews   Review[]      @relation("ReviewAuthor")
  receivedReviews  Review[]      @relation("ReviewTarget")
  reportsFiled     Report[]      @relation("ReportReporter")
  reportsReceived  Report[]      @relation("ReportTarget")
  reportsModerated Report[]      @relation("ReportModerator")
  moderatedEntries MarketEntry[] @relation("MarketModerator")

  @@index([displayName])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent") @db.Text
  ip         String?
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Game {
  id          String   @id
  title       String
  publisher   String
  developer   String   @default("")
  series      String   @default("")
  year        Int
  genres      String[]
  description String   @db.Text
  coverImage  String   @default("") @map("cover_image") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  editions      Edition[]
  marketEntries MarketEntry[]

  @@index([title])
  @@index([year])
  @@map("games")
}

model Edition {
  id             String    @id
  gameId         String    @map("game_id")
  name           String
  platform       String
  region         String
  lang           String
  media          String
  releaseDate    DateTime? @map("release_date") @db.Date
  description    String    @default("") @db.Text
  contents       String[]
  coverImages    String[]  @map("cover_images") @db.Text
  barcode        String    @default("")
  dnsProductId   String    @default("") @map("dns_product_id")
  dnsProductCode String    @default("") @map("dns_product_code")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  game          Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  copies        Copy[]
  marketEntries MarketEntry[]

  @@index([gameId])
  @@index([platform])
  @@index([region])
  @@index([lang])
  @@map("editions")
}

model Copy {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  editionId          String    @map("edition_id")
  condition          String    @default("Не указано")
  completeness       String    @default("Не указано")
  purchasePriceMinor Int?      @map("purchase_price_minor")
  purchaseDate       DateTime? @map("purchase_date") @db.Date
  notes              String    @default("") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition Edition     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  photos  CopyPhoto[]

  @@index([userId, editionId])
  @@index([editionId])
  @@map("copies")
}

model CopyPhoto {
  id        String @id @default(uuid()) @db.Uuid
  copyId    String @map("copy_id") @db.Uuid
  url       String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  copy Copy @relation(fields: [copyId], references: [id], onDelete: Cascade)

  @@index([copyId])
  @@map("copy_photos")
}

model MarketEntry {
  id          String       @id @default(uuid())
  authorId    String       @map("author_id") @db.Uuid
  kind        MarketKind
  listingType ListingType? @map("listing_type")
  gameId      String       @map("game_id")
  editionId   String?      @map("edition_id")
  title       String
  condition   String
  priceMinor  Int          @map("price_minor")
  description String       @db.Text
  status      MarketStatus @default(active)

  deliveryServices      DeliveryService[] @map("delivery_services")
  internationalShipping Boolean?          @map("international_shipping")
  packagingPriceMinor   Int?              @map("packaging_price_minor")
  shipsFrom             String            @map("ships_from")
  bidStepMinor          Int?              @map("bid_step_minor")

  startsAt          DateTime?        @map("starts_at")
  endsAt            DateTime?        @map("ends_at")
  currentPriceMinor Int?             @map("current_price_minor")
  bidCount          Int              @default(0) @map("bid_count")
  winnerId          String?          @map("winner_id") @db.Uuid
  version           Int              @default(0)
  isSeeded          Boolean          @default(false) @map("is_seeded")
  soldAt            DateTime?        @map("sold_at")
  deletedAt         DateTime?        @map("deleted_at")
  moderationStatus  ModerationStatus @default(visible) @map("moderation_status")
  moderationNote    String?          @map("moderation_note") @db.Text
  moderatedAt       DateTime?        @map("moderated_at")
  moderatorId       String?          @map("moderator_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  author    User          @relation("MarketAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  winner    User?         @relation("MarketWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  moderator User?         @relation("MarketModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  edition   Edition?      @relation(fields: [editionId], references: [id], onDelete: SetNull)
  photos    MarketPhoto[]
  bids      Bid[]
  deal      Deal?
  reports   Report[]

  @@index([kind, status, createdAt])
  @@index([authorId])
  @@index([gameId])
  @@index([editionId])
  @@index([endsAt])
  @@index([moderationStatus])
  @@map("market_entries")
}

model MarketPhoto {
  id        String @id @default(uuid()) @db.Uuid
  entryId   String @map("entry_id")
  url       String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  entry MarketEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("market_photos")
}

model Bid {
  id            String   @id @default(uuid()) @db.Uuid
  marketEntryId String   @map("market_entry_id")
  bidderId      String   @map("bidder_id") @db.Uuid
  amountMinor   Int      @map("amount_minor")
  createdAt     DateTime @default(now()) @map("created_at")

  marketEntry MarketEntry @relation(fields: [marketEntryId], references: [id], onDelete: Cascade)
  bidder      User        @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  @@index([marketEntryId, amountMinor])
  @@index([bidderId])
  @@map("bids")
}

model Deal {
  id            String     @id @default(uuid()) @db.Uuid
  marketEntryId String     @unique @map("market_entry_id")
  buyerId       String     @map("buyer_id") @db.Uuid
  sellerId      String     @map("seller_id") @db.Uuid
  amountMinor   Int        @map("amount_minor")
  status        DealStatus @default(pending)
  completedAt   DateTime?  @map("completed_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  marketEntry MarketEntry @relation(fields: [marketEntryId], references: [id], onDelete: Cascade)
  buyer       User        @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller      User        @relation("DealSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  reviews     Review[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("deals")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  dealId    String   @map("deal_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  rating    Int
  text      String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  target User @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([dealId, authorId])
  @@index([targetId])
  @@map("reviews")
}

model Report {
  id            String           @id @default(uuid()) @db.Uuid
  reporterId    String           @map("reporter_id") @db.Uuid
  targetType    ReportTargetType @map("target_type")
  targetId      String           @map("target_id") @db.Text
  marketEntryId String?          @map("market_entry_id")
  targetUserId  String?          @map("target_user_id") @db.Uuid
  reason        ReportReason
  comment       String           @default("") @db.Text
  status        ReportStatus     @default(pending)
  action        ReportAction     @default(none)
  moderatorId   String?          @map("moderator_id") @db.Uuid
  moderatorNote String?          @map("moderator_note") @db.Text
  activeKey     String?          @unique @map("active_key")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  resolvedAt    DateTime?        @map("resolved_at")

  reporter    User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser  User?        @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  marketEntry MarketEntry? @relation(fields: [marketEntryId], references: [id], onDelete: Cascade)
  moderator   User?        @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([marketEntryId])
  @@index([targetUserId])
  @@map("reports")
}

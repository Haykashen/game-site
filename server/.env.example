# Copy to server/.env and adjust for your machine.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

DATABASE_URL=postgresql://discvault:discvault@localhost:5432/discvault?schema=public

# Comma-separated list of browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Public prefix used for local uploads and returned photo URLs.
PUBLIC_API_URL=http://localhost:3001
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Leave S3_* empty to store photos on the local disk instead of MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=discvault
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/discvault
S3_FORCE_PATH_STYLE=true

# Demo login created by `npm run db:seed`.
SEED_DEMO_EMAIL=demo@discvault.local
SEED_DEMO_PASSWORD=demo12345

# user, moderator or admin. Set to admin locally to open /#/admin/reports.
SEED_DEMO_ROLE=user

# The demo seed refuses to run in production unless explicitly enabled.
ALLOW_DEMO_SEED=false

# Gemini image recognition (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

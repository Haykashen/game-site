# API image: builds the Fastify server and keeps Prisma CLI/tsx available
# for `prisma migrate deploy` and the one-off demo seed command.
FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY shared/package.json ./shared/package.json
COPY server/package.json ./server/package.json
RUN npm ci

COPY . .
RUN npm run db:generate
RUN npm run build:server

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PATH=/app/node_modules/.bin:$PATH

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/package-lock.json ./package-lock.json
COPY --from=build /app/shared ./shared
COPY --from=build /app/server/package.json ./server/package.json
COPY --from=build /app/server/tsconfig.json ./server/tsconfig.json
COPY --from=build /app/server/prisma ./server/prisma
COPY --from=build /app/server/src ./server/src
COPY --from=build /app/server/dist ./server/dist
COPY --from=build /app/src/data ./src/data

WORKDIR /app/server

EXPOSE 3001

# Apply pending migrations before accepting traffic. The seed is intentionally
# a separate manual step so restarts do not recreate demo lots.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]
